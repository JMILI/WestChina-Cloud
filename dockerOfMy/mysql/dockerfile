# 基础镜像
FROM mysql:8.0.26
# author
MAINTAINER westChina

# 设置docker默认编码db初始化数据乱码
ENV LANG C.UTF-8

# 执行 sql 脚本（子库由 zz-init-tenant-dbs.sh + slave-init.sql 初始化）
ADD ./db/xy-cloud.sql /docker-entrypoint-initdb.d/
ADD ./db/xy-config.sql /docker-entrypoint-initdb.d/
ADD ./db/xy_seata.sql /docker-entrypoint-initdb.d/
ADD ./db/slave-init.sql /opt/westsql/slave-init.sql
ADD ./db/zz-init-tenant-dbs.sh /docker-entrypoint-initdb.d/

# 增加执行权限，解决启动mysql容器后，不自动执行脚本的问题
RUN chmod +x /docker-entrypoint-initdb.d/zz-init-tenant-dbs.sh