# ==============================================================================
# WestChina-Cloud .gitignore
# ==============================================================================

# ── Java Build ──
/westChina-api/westChina-api-system/target/
/westChina-api/westChina-api-tenant/target/
/westChina-auth/target/
/westChina-common/westChina-common-core/target/
/westChina-common/westChina-common-datascope/target/
/westChina-common/westChina-common-datasource/target/
/westChina-common/westChina-common-log/target/
/westChina-common/westChina-common-message/target/
/westChina-common/westChina-common-redis/target/
/westChina-common/westChina-common-security/target/
/westChina-common/westChina-common-socket/target/
/westChina-common/westChina-common-swagger/target/
/westChina-gateway/target/
/westChina-modules/westChina-ct/target/
/westChina-modules/westChina-file/target/
/westChina-modules/westChina-gen/target/
/westChina-modules/westChina-job/target/
/westChina-modules/westChina-system/target/
/westChina-modules/westChina-tenant/target/
/westChina-visual/westChina-monitor/target/

# ── Frontend Build ──
node_modules/
dist/
*.log

# ── Runtime Logs ──
/logs/
/deploymentServer/logs/
/deploymentServer/logs*/
/dockerOfMy/mysql/logs/
/dockerOfMy/redis/*.log
/dockerOfMy/nacos/logs/
/dockerOfMy/rabbitmq/log/

# ── Docker Data (large binary volumes) ──
/dockerOfMy/mysql/data/
/dockerOfMy/redis/data/
/dockerOfMy/rabbitmq/data/
/dockerOfMy/minio/data/
/dockerOfMy/minio/config/
/dockerOfMy/mysql/logs/

# ── Python AI Environment ──
/ai-service/.conda/
/ai-service/.venv/
/ai-service/__pycache__/
/ai-service/app/__pycache__/
/ai-service/**/__pycache__/
/ai-service/.e2e-last-meta.json
/ai-service/third_party/nnDetection/
*.pyc
*.pyo

# ── AI Models (large files, download separately) ──
/ai-service/models/lung_nodule_ct_detection/models/*.pt
/ai-service/models/lung_nodule_ct_detection/models/*.ts
/ai-service/models/.cache/

# ── Patient DICOM Files (privacy) ──
/ct_file/

# ── IDE ──
.idea/
*.iws
*.iml
*.ipr
.vscode/
.classpath
.project
.settings/
.springBeans
.factorypath
.apt_generated

# ── OS ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Temp ──
/tempCode-gen/
/deploymentServer/runall/
*.xml.versionsBackup
!/**/build/*.java
!/**/build/*.html
!/**/build/*.xml

# ── Deployed JARs (built from source) ──
/deploymentServer/*.jar

# ── Frontend build output (run build_all.sh locally) ──
/deploymentServer/ui-dist/

# ── Vendored frontend sources (local patch source, not for repo) ──
/westChina-ui/ct/.vendor-src/

# ── WSL2 specific ──
*.Identifier
